# Pick a provider, then set the key and model. Restart the API after changes.
#
# LLM_PROVIDER: openai | gemini | ollama | groq | custom
# Chat and speech-to-text can use different providers.

LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=

# STT_PROVIDER: openai | gemini | groq | ollama | custom | local
# local = Whisper on this machine (no API key). Models: tiny, base, small, medium
STT_PROVIDER=local
STT_MODEL=base

# Optional overrides. If unset, the provider preset fills these in.
# LLM_BASE_URL=https://api.openai.com/v1
# STT_BASE_URL=https://api.openai.com/v1
# LLM_TEMPERATURE=0.5
# LLM_MAX_TOKENS=700

# Optional. Session database directory (default: ./data)
# AI_INTERVIEW_DATA=

# Local Whisper device: auto | cpu | cuda | mlx (Metal via mlx-whisper)
# STT_DEVICE=auto
# STT_COMPUTE_TYPE=          # default: float16 on cuda/mlx, int8 on cpu
# For Apple Silicon GPU: pip install mlx-whisper

# Required for non-local clients when the API binds 0.0.0.0 (phone on LAN / Docker).
# Loopback (127.0.0.1) stays open. If unset on a public bind, the CLI mints one.
# AI_INTERVIEW_TOKEN=

# --- examples ---
# Gemini chat + Gemini (OpenAI-compatible endpoint)
# LLM_PROVIDER=gemini
# LLM_MODEL=gemini-2.0-flash
# LLM_API_KEY=
# STT_PROVIDER=gemini
# STT_MODEL=gemini-2.0-flash

# Ollama chat (local) + local Whisper transcription
# LLM_PROVIDER=ollama
# LLM_MODEL=llama3.1:8b
# STT_PROVIDER=local
# STT_MODEL=base
# If the API runs in Docker, also set:
# LLM_BASE_URL=http://host.docker.internal:11434/v1

# Any OpenAI-compatible server
# LLM_PROVIDER=custom
# LLM_BASE_URL=http://127.0.0.1:1234/v1
# LLM_MODEL=local-model
# LLM_API_KEY=local
